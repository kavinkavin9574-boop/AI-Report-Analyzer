# Database
DATABASE_URL=sqlite:///./report_analyzer.db
# For Postgres in Docker: postgresql://app:change-this@db:5432/reports

# LLM (OpenRouter) -- required for AI summary/findings and RAG chat.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Default model used when a request doesn't specify one (OpenRouter slug,
# "provider/model"). Browse models at https://openrouter.ai/models
LLM_MODEL=anthropic/claude-sonnet-4.5
# Comma-separated list of models offered in the frontend's model switcher.
AVAILABLE_MODELS=anthropic/claude-sonnet-4.5,anthropic/claude-3.5-haiku,openai/gpt-4o,openai/gpt-4o-mini,google/gemini-2.5-pro,google/gemini-2.5-flash,meta-llama/llama-3.3-70b-instruct,deepseek/deepseek-chat
# Sent as attribution headers to OpenRouter (optional but recommended)
APP_URL=http://localhost:5173
APP_TITLE=AI Report Analyzer

# Storage
UPLOAD_DIR=./uploads
PROCESSED_DIR=./processed
MAX_UPLOAD_MB=20

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# OCR
OCR_LANG=en
